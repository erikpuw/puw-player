// Puw Player — approved layout, one frameless window.

import { ListView, ScrollView } from "std-widgets.slint";

export struct TrackRow {
    title: string,
    artist: string,
    duration: string,
    cover: image,
    missing: bool,
}

export struct PlaylistRow {
    name: string,
    count: string,
    cover: image,
}

export struct LyricRow {
    text: string,
    active: bool,
    timed: bool,
    seconds: int,
}

export global Theme {
    in-out property <color> bg: #17191a;
    in-out property <color> surface: #1e2223;
    in-out property <color> text: #e8ebe8;
    in-out property <color> muted: #97a09c;
    in-out property <color> accent: #c8e38c;
    in-out property <color> accent-soft: #c8e38c2a;
    in-out property <color> hover: #ffffff14;
    in-out property <color> line: #ffffff1f;
    in-out property <color> on-accent: #17191a;
    in-out property <bool> dark: true;
}

// Interface language. Rust flips `en` from Settings; every label binds through `t`.
export global I18n {
    in-out property <bool> en: false;
    pure public function t(vi: string, eng: string) -> string {
        return self.en ? eng : vi;
    }
}

export global Motion {
    in-out property <duration> fast: 140ms;
    in-out property <duration> slow: 240ms;
}

export global Icons {
    out property <string> play: "M 8 5.5 L 19 12 L 8 18.5 Z";
    out property <string> previous: "M 5.5 5.5 H 8.5 V 18.5 H 5.5 Z M 19 5.5 L 9.5 12 L 19 18.5 Z";
    out property <string> next: "M 15.5 5.5 H 18.5 V 18.5 H 15.5 Z M 5 5.5 L 14.5 12 L 5 18.5 Z";
    out property <string> stop: "M 6.5 6.5 H 17.5 V 17.5 H 6.5 Z";
    out property <string> shuffle: "M 4 8 H 7 L 17 16 H 20 M 17 8 H 20 M 4 16 H 7 L 11 12 M 17.5 5.5 L 20 8 L 17.5 10.5 M 17.5 13.5 L 20 16 L 17.5 18.5";
    out property <string> repeat: "M 4.5 12 A 7.5 7.5 0 0 1 17 7.2 M 19.5 12 A 7.5 7.5 0 0 1 7 16.8 M 14.5 4.2 L 17.6 7.1 L 14.2 9.2 M 9.5 19.8 L 6.4 16.9 L 9.8 14.8";
    out property <string> skip-back: "M 12 4.5 A 7.5 7.5 0 1 1 4.5 12 M 12 4.5 L 15.5 1.5 M 12 4.5 L 15.5 7.5";
    out property <string> skip-forward: "M 12 4.5 A 7.5 7.5 0 1 0 19.5 12 M 12 4.5 L 8.5 1.5 M 12 4.5 L 8.5 7.5";
    out property <string> volume: "M 4 9.5 H 7.5 L 11.5 6 V 18 L 7.5 14.5 H 4 Z M 15 9 A 4.5 4.5 0 0 1 15 15 M 17.5 6.5 A 8 8 0 0 1 17.5 17.5";
    out property <string> settings: "M 12 9 A 3 3 0 1 0 12 15 A 3 3 0 1 0 12 9 Z M 12 3.5 V 6 M 12 18 V 20.5 M 3.5 12 H 6 M 18 12 H 20.5 M 6 6 L 7.8 7.8 M 16.2 16.2 L 18 18 M 18 6 L 16.2 7.8 M 7.8 16.2 L 6 18";
    out property <string> lyrics: "M 6 3.5 H 14.5 L 18.5 7.5 V 20.5 H 6 Z M 9 11 H 15.5 M 9 14.5 H 15.5 M 9 18 H 13";
    out property <string> plus: "M 12 5 V 19 M 5 12 H 19";
    out property <string> list: "M 4 7 H 20 M 4 12 H 20 M 4 17 H 14";
    out property <string> trash: "M 4.5 7 H 19.5 M 9 7 V 4.5 H 15 V 7 M 6.5 7 L 7.6 20 H 16.4 L 17.5 7";
    out property <string> pencil: "M 4.5 19.5 L 5.6 14.4 L 15.6 4.4 L 19.6 8.4 L 9.6 18.4 Z";
    out property <string> minimize: "M 6 12 H 18";
    out property <string> maximize: "M 6 6 H 18 V 18 H 6 Z";
    out property <string> restore: "M 8.5 8.5 H 18.5 V 18.5 H 8.5 Z M 6 16 V 5.5 H 16";
    out property <string> close: "M 6.5 6.5 L 17.5 17.5 M 17.5 6.5 L 6.5 17.5";
    out property <string> headphones: "M 4.5 15.5 V 12.5 A 7.5 7.5 0 0 1 19.5 12.5 V 15.5 M 4.5 14.5 H 7.5 V 20 H 4.5 Z M 16.5 14.5 H 19.5 V 20 H 16.5 Z";
    out property <string> waveform: "M 3 10 V 14 M 7.5 6 V 18 M 12 3 V 21 M 16.5 6 V 18 M 21 10 V 14";
}

// Layouts pin items with a max size to the top edge, so icon components leave
// their cross axis free and center their content themselves.
component Glyph inherits Rectangle {
    in property <length> glyph-size: 18px;
    in property <string> icon: "";
    in property <color> tint: Theme.text;
    in property <bool> filled: false;
    in property <length> weight: 1.8px;
    min-width: glyph-size;
    min-height: glyph-size;
    preferred-width: glyph-size;
    preferred-height: glyph-size;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    Path {
        x: (parent.width - root.glyph-size) / 2;
        y: (parent.height - root.glyph-size) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: root.filled ? root.tint : transparent;
        stroke: root.filled ? transparent : root.tint;
        stroke-width: root.weight;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> badge: "";
    // Lets a badge fade in/out instead of scaling text (repeat-one "1").
    in property <bool> badge-shown: true;
    in property <length> size: 34px;
    in property <length> icon-size: 18px;
    in property <bool> filled-icon: false;
    in property <bool> active: false;
    in property <bool> plate: false;
    in property <bool> enabled: true;
    in property <color> tint: Theme.muted;
    in property <length> weight: 1.8px;
    callback clicked();
    min-width: size;
    max-width: size;
    min-height: size;
    preferred-height: size;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: label;
    property <length> press-inset: touch.pressed && root.enabled ? 2px : 0px;
    focus-scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Return || event.text == Key.Space)) {
                root.clicked();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
    Rectangle {
        x: root.press-inset / 2;
        y: (parent.height - root.size + root.press-inset) / 2;
        width: root.size - root.press-inset;
        height: root.size - root.press-inset;
        border-radius: (root.size - root.press-inset) / 2;
        border-width: focus-scope.has-focus ? 2px : 0px;
        border-color: Theme.accent;
        background: (touch.has-hover && root.enabled) ? (root.active ? Theme.accent-soft : Theme.hover) : (root.plate ? Theme.surface : transparent);
        animate background { duration: Motion.fast; }
        Glyph {
            x: (parent.width - root.icon-size) / 2;
            y: (parent.height - root.icon-size) / 2;
            width: root.icon-size;
            height: root.icon-size;
            glyph-size: root.icon-size;
            icon: root.icon;
            filled: root.filled-icon;
            weight: root.weight;
            tint: root.active ? Theme.accent : root.tint;
        }
        if root.badge != "": Text {
            width: parent.width;
            height: parent.height;
            text: root.badge;
            opacity: root.badge-shown ? 1 : 0;
            font-size: 9px;
            animate opacity { duration: Motion.fast; easing: ease-out; }
            font-weight: 700;
            color: root.active ? Theme.accent : root.tint;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
            clicked => { if (root.enabled) { root.clicked(); } }
        }
    }
}

// Cover-flow side panel. Slint has no 3D transform, so the image is drawn as thin
// vertical strips whose height interpolates between the two edges -> a perspective trapezoid.
component PerspectiveCover inherits Rectangle {
    in property <image> source;
    in property <length> left-height;
    in property <length> right-height;
    property <int> strips: 20;
    visible: source.width > 0;
    for _s[i] in root.strips: Image {
        property <float> t: (i + 0.5) / root.strips;
        x: root.width * i / root.strips;
        width: root.width / root.strips + 1px;
        height: root.left-height + (root.right-height - root.left-height) * t;
        y: (root.height - self.height) / 2;
        source: root.source;
        source-clip-x: floor(root.source.width * i / root.strips);
        source-clip-y: 0;
        source-clip-width: max(1, floor(root.source.width / root.strips));
        source-clip-height: root.source.height;
        image-fit: fill;
    }
}

// One cover-flow cover at continuous slot position `p` (0 = center, ±1 near, ±2 far, ±3 gone).
// Geometry interpolates between slot keyframes measured from approved-player.png.
component FlowCover inherits Rectangle {
    in property <image> source;
    in property <float> p;
    in property <float> side: 1;
    property <float> a: min(3, abs(p));
    property <int> seg: a <= 1 ? 0 : (a <= 2 ? 1 : 2);
    property <float> t: a - seg;
    // Slot keyframes 0..3: center offset, width, inner/outer edge height, opacity.
    property <[float]> center-k: [0, 128 + 50 * side, 128 + 131 * side, 128 + 177 * side];
    property <[float]> width-k: [256, 100 * side, 62 * side, 30 * side];
    property <[float]> inner-k: [256, 206, 182, 160];
    property <[float]> outer-k: [256, 230, 204, 180];
    property <[float]> alpha-k: [1, 0.9, 0.7, 0];
    pure function at(k: [float]) -> float {
        k[seg] + (k[seg + 1] - k[seg]) * t
    }
    property <length> w: at(width-k) * 1px;
    property <length> inner: at(inner-k) * 1px;
    property <length> outer: at(outer-k) * 1px;
    property <length> cx: self.width / 2 + (p < 0 ? -1 : 1) * at(center-k) * 1px;
    visible: source.width > 0 && a < 3;
    opacity: at(alpha-k);
    z: -a;
    // At rest the center cover keeps its aspect ratio (contain); moving covers use perspective strips.
    if root.a < 0.001: Rectangle {
        x: (root.width - 256px) / 2;
        y: (root.height - 256px) / 2;
        width: 256px;
        height: 256px;
        border-radius: 6px;
        clip: true;
        background: Theme.surface;
        Image { width: parent.width; height: parent.height; source: root.source; image-fit: contain; }
    }
    if root.a >= 0.001: PerspectiveCover {
        x: root.cx - root.w / 2;
        y: 0;
        width: root.w;
        height: root.height;
        source: root.source;
        left-height: root.p < 0 ? root.outer : root.inner;
        right-height: root.p < 0 ? root.inner : root.outer;
    }
}

// Play triangle <-> pause bars morph. Both shapes are two quads with matching vertices,
// so every point interpolates linearly with `m` (0 = play, 1 = pause).
component PlayPauseMorph inherits Path {
    in property <float> m;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: transparent;
    MoveTo { x: 8 - 1.5 * root.m; y: 5.5 - 0.5 * root.m; }
    LineTo { x: 13.6 - 3.1 * root.m; y: 8.75 - 3.75 * root.m; }
    LineTo { x: 13.6 - 3.1 * root.m; y: 15.25 + 3.75 * root.m; }
    LineTo { x: 8 - 1.5 * root.m; y: 18.5 + 0.5 * root.m; }
    Close { }
    MoveTo { x: 13.5; y: 8.75 - 3.75 * root.m; }
    LineTo { x: 19 - 1.5 * root.m; y: 12 - 7 * root.m; }
    LineTo { x: 19 - 1.5 * root.m; y: 12 + 7 * root.m; }
    LineTo { x: 13.5; y: 15.25 + 3.75 * root.m; }
    Close { }
}

// Lossless mark: two phase-shifted sine strands, thin behind bold (our own drawing).
component WaveMark inherits Rectangle {
    in property <length> mark-size: 16px;
    in property <color> tint: Theme.text;
    min-width: mark-size * 34 / 20;
    max-width: mark-size * 34 / 20;
    min-height: mark-size;
    horizontal-stretch: 0;
    // One wave period per strand: up from the lower left, crest, trough, rising tail.
    for strand[k] in [{ x: 2, w: 0.055 }, { x: 9, w: 0.12 }] : Path {
        y: (parent.height - root.mark-size) / 2;
        width: parent.width;
        height: root.mark-size;
        viewbox-width: 34;
        viewbox-height: 20;
        commands: "M \{strand.x} 15 C \{strand.x + 3.5} 1.5, \{strand.x + 7.5} 1.5, \{strand.x + 11} 10 S \{strand.x + 18.5} 18.5, \{strand.x + 22} 5";
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.mark-size * strand.w;
        stroke-line-cap: round;
    }
}

// Full-width hairline that fades out at both ends.
component HDivider inherits Rectangle {
    height: 1px;
    background: @linear-gradient(90deg, transparent 0%, Theme.line 12%, Theme.line 88%, transparent 100%);
}

//Thin vertical divider that stays centered inside a row layout.
component VDivider inherits Rectangle {
    in property <length> line-height: 18px;
    min-width: 1px;
    max-width: 1px;
    Rectangle {
        y: (parent.height - root.line-height) / 2;
        width: 1px;
        height: root.line-height;
        background: Theme.line;
    }
}

// Soft fade at the top or bottom edge of a scrollable list when content extends past that edge.
component ScrollEdgeFade inherits Rectangle {
    in property <bool> top: true;
    in property <bool> shown: false;
    height: 22px;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Motion.fast; easing: ease-out; }
    background: root.top
        ? @linear-gradient(180deg, Theme.bg 0%, Theme.bg.transparentize(1.0) 100%)
        : @linear-gradient(180deg, Theme.bg.transparentize(1.0) 0%, Theme.bg 100%);
}

component Timeline inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    in property <bool> enabled: true;
    callback seek-to(float);
    min-height: 28px;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: slider;
    accessible-label: I18n.t("Tiến trình bài hát", "Track progress");
    property <float> ratio: duration > 0 ? min(1, max(0, position / duration)) : 0;
    property <length> thumb-size: (touch.has-hover || touch.pressed) && root.enabled ? 16px : 14px;
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: parent.width;
        border-radius: 2px;
        background: Theme.muted.transparentize(0.55);
    }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: parent.width * root.ratio;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: min(parent.width - root.thumb-size, max(0px, parent.width * root.ratio - root.thumb-size / 2));
        y: (parent.height - root.thumb-size) / 2;
        width: root.thumb-size;
        height: root.thumb-size;
        border-radius: root.thumb-size / 2;
        background: Theme.accent.brighter(touch.pressed ? 0.25 : 0.15);
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if (root.enabled && event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                    root.seek-to(min(1, max(0, (touch.mouse-x / 1px) / (root.width / 1px))) * root.duration);
                }
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
}

component VolumeSlider inherits Rectangle {
    in property <float> volume;
    callback set-volume(float);
    min-height: 26px;
    accessible-role: slider;
    accessible-label: I18n.t("Âm lượng", "Volume");
    property <length> thumb-size: volume-touch.has-hover || volume-touch.pressed ? 16px : 14px;
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: parent.width;
        border-radius: 2px;
        background: Theme.muted.transparentize(0.55);
    }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: parent.width * root.volume;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: min(parent.width - root.thumb-size, max(0px, parent.width * root.volume - root.thumb-size / 2));
        y: (parent.height - root.thumb-size) / 2;
        width: root.thumb-size;
        height: root.thumb-size;
        border-radius: root.thumb-size / 2;
        background: Theme.accent.brighter(volume-touch.pressed ? 0.25 : 0.15);
    }
    volume-touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left
                && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move)) {
                root.set-volume(min(1, max(0, (volume-touch.mouse-x / 1px) / (root.width / 1px))));
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
}

component TabHeader inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    min-height: 44px;
    min-width: label.preferred-width;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: text;
    tab-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
    label := Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 16px;
        font-weight: root.selected ? 600 : 400;
        color: root.selected ? Theme.accent : (hover.has-hover || tab-focus.has-focus ? Theme.text : Theme.muted);
        animate color { duration: Motion.fast; }
        vertical-alignment: center;
        horizontal-alignment: left;
    }
    Rectangle {
        x: 0;
        y: parent.height - 2px;
        height: 2px;
        width: parent.width;
        border-radius: 1px;
        background: Theme.accent;
        opacity: root.selected ? 1 : (tab-focus.has-focus ? 0.5 : 0);
        animate opacity { duration: Motion.fast; }
    }
    hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TrackListItem inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> duration;
    in property <image> cover;
    in property <bool> missing;
    in property <bool> current;
    in property <bool> selected;
    // Optional hover actions at the row's right edge: `action` rightmost, `extra` left of it.
    in property <string> action-icon: "";
    in property <string> action-label: "";
    in property <string> extra-icon: "";
    in property <string> extra-label: "";
    callback activate();
    callback action();
    callback extra();
    property <bool> show-action: action-icon != ""
        && (touch.has-hover || action-touch.has-hover || extra-touch.has-hover);
    height: 72px;
    background: selected ? Theme.hover : (touch.has-hover ? Theme.hover : transparent);
    accessible-role: list-item;
    accessible-label: title;
    Rectangle {
        x: 0;
        y: (parent.height - 30px) / 2;
        width: 3px;
        height: 30px;
        border-radius: 2px;
        background: Theme.accent;
        opacity: current ? 1 : 0;
    }
    Rectangle {
        x: 10px;
        y: (parent.height - 52px) / 2;
        width: 52px;
        height: 52px;
        border-radius: 6px;
        background: Theme.surface;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.cover;
            image-fit: ImageFit.cover;
        }
    }
    Text {
        x: 76px;
        y: 14px;
        width: parent.width - 76px - 74px;
        height: 24px;
        text: root.title;
        color: root.missing ? Theme.muted : Theme.text;
        font-size: 16px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 76px;
        y: parent.height - 34px;
        width: parent.width - 76px - 74px;
        height: 20px;
        text: root.missing ? I18n.t("Không tìm thấy tệp", "File not found") : root.artist;
        color: Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 66px;
        width: 56px;
        height: parent.height;
        text: root.duration;
        visible: !root.show-action;
        color: Theme.muted;
        font-size: 14px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }
    // Declared after the row TouchArea so it sits on top and receives its own clicks.
    Rectangle {
        visible: root.show-action;
        x: parent.width - 40px;
        y: (parent.height - 30px) / 2;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: action-touch.has-hover ? Theme.accent-soft : Theme.hover;
        accessible-role: button;
        accessible-label: root.action-label;
        Glyph {
            x: 7px;
            y: 7px;
            width: 16px;
            height: 16px;
            glyph-size: 16px;
            icon: root.action-icon;
            tint: action-touch.has-hover ? Theme.accent : Theme.text;
        }
        action-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.action(); }
        }
    }
    Rectangle {
        visible: root.show-action && root.extra-icon != "";
        x: parent.width - 76px;
        y: (parent.height - 30px) / 2;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: extra-touch.has-hover ? Theme.accent-soft : Theme.hover;
        accessible-role: button;
        accessible-label: root.extra-label;
        Glyph {
            x: 7px;
            y: 7px;
            width: 16px;
            height: 16px;
            glyph-size: 16px;
            icon: root.extra-icon;
            tint: extra-touch.has-hover ? Theme.accent : Theme.text;
        }
        extra-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.extra(); }
        }
    }
}

component PlaylistListItem inherits Rectangle {
    in property <string> name;
    in property <string> count;
    in property <image> cover;
    in property <bool> current;
    callback activate();
    height: 64px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: name;
    Rectangle {
        x: 0;
        y: (parent.height - 26px) / 2;
        width: 3px;
        height: 26px;
        border-radius: 2px;
        background: Theme.accent;
        opacity: root.current ? 1 : 0;
    }
    Rectangle {
        x: 12px;
        y: (parent.height - 40px) / 2;
        width: 40px;
        height: 40px;
        border-radius: 6px;
        background: Theme.surface;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.cover;
            image-fit: ImageFit.cover;
        }
    }
    Text {
        x: 60px;
        y: 12px;
        width: parent.width - 68px;
        height: 22px;
        text: root.name;
        color: Theme.text;
        font-size: 15px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 60px;
        y: parent.height - 30px;
        width: parent.width - 68px;
        height: 18px;
        text: root.count;
        color: Theme.muted;
        font-size: 12px;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }
}

export component AppWindow inherits Window {
    in property <string> app-title: "Puw Player";

    in-out property <[TrackRow]> tracks;
    in-out property <[PlaylistRow]> playlists;
    in-out property <[TrackRow]> playlist-tracks;
    in-out property <[LyricRow]> lyrics;

    in-out property <bool> has-track;
    in-out property <bool> playing;
    in-out property <bool> shuffle;
    in-out property <int> repeat-mode: 0;
    in-out property <int> tab: 0;
    in-out property <bool> lyrics-visible;
    in-out property <bool> lyrics-instrumental;
    in-out property <bool> lyrics-plain;
    in-out property <string> lyrics-status;
    in-out property <bool> following: true;
    in-out property <int> active-lyric: -1;
    // Bottom edge of the sung line inside the lyric content; Rust keeps it in sync with the model.
    in property <length> lyric-anchor: 0px;
    in-out property <string> lyric-offset: "+0.0s";
    in-out property <bool> settings-visible;
    in-out property <bool> lyrics-online;
    in-out property <int> theme-mode: 0;
    in-out property <int> current-track: -1;
    in-out property <int> current-playlist: -1;
    in-out property <int> current-playlist-track: -1;
    in-out property <string> current-playlist-name: "";
    in-out property <string> current-playlist-count: "";
    in-out property <int> selected-track: -1;
    in-out property <bool> window-maximized;
    in-out property <bool> add-menu-visible;
    in-out property <int> dialog-mode: 0;
    // Library row whose "add to playlist" picker is open; -1 = closed.
    in-out property <int> picker-track: -1;
    // Library row waiting for the "remove from library" confirmation (dialog-mode 4).
    in-out property <int> pending-remove: -1;
    // Slint 1.18 ListViews instantiated before the window has its real size loop
    // ("long callback/instantiation chain detected"). Rust sets this once the window is shown.
    in-out property <bool> lists-ready: false;
    in-out property <string> dialog-text;
    in-out property <string> dialog-title;
    in-out property <string> status-message;
    in-out property <bool> has-status;
    in-out property <bool> importing;

    in-out property <string> now-title: I18n.t("Chưa chọn bài", "No track selected");
    in-out property <string> now-artist: I18n.t("Chọn một bài hát để bắt đầu", "Pick a song to start");
    in-out property <string> now-source: "";
    in-out property <string> now-quality: "";
    // "Atmos" / "Binaural" / "Binaural Atmos" when the release is named so; "" otherwise.
    in-out property <string> now-spatial: "";
    // 0 = no tag (lossy: bitrate is part of now-source), 2 = lossless, 3 = hi-res.
    in-out property <int> now-quality-tier: 0;
    in-out property <string> now-device: "";
    in-out property <image> cover;
    in-out property <image> cover-prev;
    in-out property <image> cover-next;
    in-out property <image> cover-prev2;
    in-out property <image> cover-next2;

    in-out property <float> position;
    in-out property <float> duration;
    in-out property <float> volume: 1;
    in-out property <string> position-label: "00:00";
    in-out property <string> duration-label: "00:00";
    in-out property <string> volume-label: "100%";

    // Cover-flow slide: flow-shift eases from ±1 to 0 after a track change.
    property <float> flow-from: 0;
    property <duration> flow-start;
    property <bool> flow-active: false;
    property <duration> flow-duration: Motion.slow * 1.8;
    property <float> flow-t: flow-active ? min(1, (animation-tick() - flow-start) / flow-duration) : 1;
    // Smoothstep: gentle start and finish, so the first frame after a track change doesn't jump.
    out property <float> flow-shift: flow-from * (1 - flow-t * flow-t * (3 - 2 * flow-t));
    // dir: +1 = moved to next (strip slides left), -1 = previous, 0 = jump without slide.
    public function start-flow(dir: float) {
        if (dir == 0 || flow-duration <= 0ms) {
            flow-active = false;
            return;
        }
        flow-from = dir;
        flow-start = animation-tick();
        flow-active = true;
    }
    flow-timer := Timer {
        interval: root.flow-duration + 30ms;
        running: root.flow-active;
        triggered => { root.flow-active = false; }
    }

    callback window-minimize();
    callback window-maximize();
    callback window-close();
    callback play-pause();
    callback stop();
    callback next();
    callback previous();
    callback seek-backward();
    callback seek-forward();
    callback seek-to(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback activate-track(int);
    callback select-playlist(int);
    callback play-playlist();
    callback add-files();
    callback add-folder();
    callback create-playlist(string);
    callback rename-playlist(string);
    callback delete-playlist();
    callback add-track-to-playlist(int, int);
    callback remove-playlist-track(int);
    callback toggle-lyrics();
    callback toggle-settings();
    callback set-theme(int);
    callback set-language(bool);
    callback set-lyrics-online(bool);
    callback lyric-click(int);
    callback lyric-offset-step(int);
    callback dialog-confirm(string);
    callback dialog-cancel();
    callback dismiss-status();
    callback remove-missing();

    function ask-remove-track(index: int) {
        root.pending-remove = index;
        root.dialog-title = I18n.t("Xóa bài khỏi thư viện?", "Remove from library?");
        root.dialog-text = "";
        root.dialog-mode = 4;
    }

    title: app-title;
    icon: @image-url("../assets/puw_1024.png");
    no-frame: true;
    resize-border-width: 5px;
    min-width: 960px;
    min-height: 600px;
    preferred-width: 1200px;
    preferred-height: 680px;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    // content-y is negative once scrolled, so a positive target here never moved the pane.
    changed active-lyric => {
        if (root.following && root.active-lyric >= 0) {
            let limit = max(0px, lyric-scroll.content-height - lyric-scroll.height);
            lyric-scroll.content-y = -min(limit, max(0px, root.lyric-anchor - lyric-scroll.height * 0.62));
        }
    }
    // Shuffle lands the playing row anywhere in the library, so pull it back into view.
    changed current-track => {
        if (root.current-track >= 0 && songs-list.content-height > 0px) {
            let pitch = songs-list.content-height / max(1, root.tracks.length);
            let top = root.current-track * pitch;
            if (top < -songs-list.content-y) { songs-list.content-y = -top; }
            if (top + pitch > -songs-list.content-y + songs-list.height) {
                songs-list.content-y = min(0px, -(top + pitch - songs-list.height));
            }
        }
    }
    changed current-playlist-track => {
        if (root.current-playlist-track >= 0 && playlist-songs-list.content-height > 0px) {
            let pitch = playlist-songs-list.content-height / max(1, root.playlist-tracks.length);
            let top = root.current-playlist-track * pitch;
            if (top < -playlist-songs-list.content-y) { playlist-songs-list.content-y = -top; }
            if (top + pitch > -playlist-songs-list.content-y + playlist-songs-list.height) {
                playlist-songs-list.content-y = min(0px, -(top + pitch - playlist-songs-list.height));
            }
        }
    }
    // Return keyboard shortcuts to the window once a dialog or picker closes.
    changed dialog-mode => {
        if (root.dialog-mode == 0 && root.picker-track < 0) { app-focus.focus(); }
    }
    changed picker-track => {
        if (root.picker-track < 0 && root.dialog-mode == 0) { app-focus.focus(); }
    }
    changed following => {
        if (root.following && root.active-lyric >= 0) {
            let limit = max(0px, lyric-scroll.content-height - lyric-scroll.height);
            lyric-scroll.content-y = -min(limit, max(0px, root.lyric-anchor - lyric-scroll.height * 0.62));
        }
    }

    app-focus := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: true;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Space) { root.play-pause(); return EventResult.accept; }
            if (event.text == Key.LeftArrow) { root.seek-backward(); return EventResult.accept; }
            if (event.text == Key.RightArrow) { root.seek-forward(); return EventResult.accept; }
            if (event.text == Key.UpArrow) { root.set-volume(min(1, root.volume + 0.05)); return EventResult.accept; }
            if (event.text == Key.DownArrow) { root.set-volume(max(0, root.volume - 0.05)); return EventResult.accept; }
            if (event.text == Key.Escape) {
                if (root.dialog-mode > 0) { root.dialog-cancel(); return EventResult.accept; }
                if (root.add-menu-visible) { root.add-menu-visible = false; return EventResult.accept; }
                if (root.settings-visible) { root.toggle-settings(); return EventResult.accept; }
                if (root.lyrics-visible) { root.toggle-lyrics(); return EventResult.accept; }
            }
            return EventResult.reject;
        }
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.window-maximized ? 0px : 12px;
        clip: true;
        background: Theme.bg;

        // ── Title bar ────────────────────────────────────────────────
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 56px;
                background: transparent;
                // Above the body so the "+" dropdown is not painted over by the right column.
                z: 10;

                WindowMoveArea {
                    x: 0;
                    y: 0;
                    width: parent.width - 380px;
                    height: parent.height;
                }

                HorizontalLayout {
                    x: 18px;
                    y: 0;
                    width: parent.width - 36px;
                    height: parent.height;
                    spacing: 0;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Glyph {
                            glyph-size: 22px;
                            icon: Icons.waveform;
                            weight: 2.4px;
                            tint: Theme.accent;
                        }
                        Text {
                            text: "Puw Player";
                            color: Theme.text;
                            font-size: 17px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;
                        IconButton {
                            icon: Icons.plus;
                            label: I18n.t("Thêm nhạc", "Add music");
                            active: root.add-menu-visible;
                            clicked => { root.add-menu-visible = !root.add-menu-visible; }
                        }
                        IconButton {
                            icon: Icons.list;
                            label: "Playlist";
                            active: root.tab == 1 && !root.lyrics-visible && !root.settings-visible;
                            clicked => {
                                root.lyrics-visible = false;
                                root.settings-visible = false;
                                root.tab = 1;
                            }
                        }
                        IconButton {
                            icon: Icons.lyrics;
                            label: I18n.t("Lời bài hát", "Lyrics");
                            active: root.lyrics-visible;
                            clicked => { root.toggle-lyrics(); }
                        }
                        IconButton {
                            icon: Icons.settings;
                            label: I18n.t("Cài đặt", "Settings");
                            active: root.settings-visible;
                            clicked => { root.toggle-settings(); }
                        }
                        VDivider { line-height: 22px; }
                        IconButton {
                            icon: Icons.minimize;
                            label: I18n.t("Thu nhỏ", "Minimize");
                            icon-size: 16px;
                            clicked => { root.window-minimize(); }
                        }
                        IconButton {
                            icon: root.window-maximized ? Icons.restore : Icons.maximize;
                            label: root.window-maximized ? I18n.t("Khôi phục", "Restore") : I18n.t("Phóng to", "Maximize");
                            icon-size: 15px;
                            clicked => { root.window-maximize(); }
                        }
                        IconButton {
                            icon: Icons.close;
                            label: I18n.t("Đóng", "Close");
                            icon-size: 15px;
                            clicked => { root.window-close(); }
                        }
                    }
                }

                Rectangle {
                    x: parent.width - 336px;
                    y: 50px;
                    width: 210px;
                    height: 92px;
                    border-radius: 10px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.line;
                    visible: root.add-menu-visible;
                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding: 4px;
                        spacing: 0;
                        Rectangle {
                            min-height: 40px;
                            background: add-file-touch.has-hover ? Theme.hover : transparent;
                            border-radius: 7px;
                            Text {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                text: I18n.t("Thêm tệp nhạc…", "Add music files…");
                                color: Theme.text;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            add-file-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.add-menu-visible = false; root.add-files(); }
                            }
                        }
                        Rectangle {
                            min-height: 40px;
                            background: add-folder-touch.has-hover ? Theme.hover : transparent;
                            border-radius: 7px;
                            Text {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                text: I18n.t("Thêm thư mục…", "Add folder…");
                                color: Theme.text;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            add-folder-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.add-menu-visible = false; root.add-folder(); }
                            }
                        }
                    }
                }
            }

            // ── Body ────────────────────────────────────────────────────
            Rectangle {
                x: 0;
                y: 56px;
                width: parent.width;
                height: parent.height - 62px;
                background: transparent;

                // Left column
                Rectangle {
                    x: 24px;
                    y: 0;
                    width: parent.width * 0.55 - 60px;
                    height: parent.height;
                    background: transparent;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: max(220px, parent.height - 322px);
                        background: transparent;
                        clip: true;

                        // Five slots -2..2 placed by continuous position p = slot + flow-shift.
                        // Changing track animates flow-shift from ±1 to 0, so the whole strip slides one slot.
                        property <float> side: min(1, max(0, (self.width / 2 - 128px) / 164px));
                        FlowCover { width: parent.width; height: parent.height; side: parent.side; source: root.cover-prev2; p: -2 + root.flow-shift; }
                        FlowCover { width: parent.width; height: parent.height; side: parent.side; source: root.cover-prev; p: -1 + root.flow-shift; }
                        FlowCover { width: parent.width; height: parent.height; side: parent.side; source: root.cover; p: root.flow-shift; }
                        FlowCover { width: parent.width; height: parent.height; side: parent.side; source: root.cover-next; p: 1 + root.flow-shift; }
                        FlowCover { width: parent.width; height: parent.height; side: parent.side; source: root.cover-next2; p: 2 + root.flow-shift; }

                        Rectangle {
                            visible: root.cover.width == 0;
                            x: parent.width / 2 - 128px;
                            y: (parent.height - 256px) / 2;
                            width: 256px;
                            height: 256px;
                            border-radius: 6px;
                            background: Theme.surface;
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                Glyph {
                                    glyph-size: 40px;
                                    icon: Icons.lyrics;
                                    tint: Theme.line;
                                }
                                Text {
                                    text: root.has-track ? I18n.t("Không có bìa", "No artwork") : I18n.t("Chưa chọn bài", "No track selected");
                                    color: Theme.muted;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle {
                        x: 0;
                        y: parent.height - 322px;
                        width: parent.width;
                        height: 104px;
                        background: transparent;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: root.now-title;
                                color: Theme.text;
                                font-size: 26px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: root.now-artist;
                                color: Theme.muted;
                                font-size: 15px;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: root.now-source;
                                    color: Theme.muted;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                // Lossless mark + label, no box. 3 = Hi-Res Lossless (accent), 2 = Lossless.
                                // Lossy bitrate lives in the text line.
                                if root.now-quality-tier >= 2: HorizontalLayout {
                                    spacing: 5px;
                                    accessible-role: text;
                                    accessible-label: root.now-quality;
                                    WaveMark {
                                        mark-size: 18px;
                                        tint: root.now-quality-tier == 3 ? Theme.accent : Theme.text;
                                    }
                                    Text {
                                        text: root.now-quality;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.now-quality-tier == 3 ? Theme.accent : Theme.text;
                                        vertical-alignment: center;
                                    }
                                }
                                // Spatial release (usually a stereo/binaural render): headphones hint + name.
                                if root.now-spatial != "": HorizontalLayout {
                                    spacing: 4px;
                                    accessible-role: text;
                                    accessible-label: root.now-spatial + I18n.t(", nên nghe bằng tai nghe", ", best on headphones");
                                    Glyph {
                                        glyph-size: 14px;
                                        weight: 1.6px;
                                        icon: Icons.headphones;
                                        tint: Theme.muted;
                                    }
                                    Text {
                                        text: root.now-spatial;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    HDivider { x: 0; y: parent.height - 212px; width: parent.width; }

                    HorizontalLayout {
                        x: 0;
                        y: parent.height - 204px;
                        width: parent.width;
                        height: 34px;
                        spacing: 18px;
                        Text {
                            text: root.position-label;
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Timeline {
                            horizontal-stretch: 1;
                            position: root.position;
                            duration: root.duration;
                            enabled: root.has-track;
                            seek-to(seconds) => { root.seek-to(seconds); }
                        }
                        Text {
                            text: root.duration-label;
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        x: 0;
                        y: parent.height - 158px;
                        width: parent.width;
                        height: 76px;
                        alignment: center;
                        spacing: 18px;

                        IconButton {
                            icon: Icons.shuffle;
                            label: I18n.t("Phát ngẫu nhiên", "Shuffle");
                            size: 46px;
                            icon-size: 26px;
                            weight: 2.2px;
                            plate: true;
                            tint: Theme.text;
                            active: root.shuffle;
                            clicked => { root.toggle-shuffle(); }
                        }
                        IconButton {
                            icon: Icons.skip-back;
                            badge: "10";
                            label: I18n.t("Lùi 10 giây", "Back 10 seconds");
                            size: 46px;
                            icon-size: 32px;
                            weight: 2px;
                            plate: true;
                            enabled: root.has-track;
                            tint: Theme.text;
                            clicked => { root.seek-backward(); }
                        }
                        IconButton {
                            icon: Icons.previous;
                            label: I18n.t("Bài trước", "Previous");
                            size: 52px;
                            icon-size: 24px;
                            filled-icon: true;
                            plate: true;
                            enabled: root.has-track;
                            tint: Theme.text;
                            clicked => { root.previous(); }
                        }
                        Rectangle {
                            min-width: 70px;
                            max-width: 70px;
                            min-height: 70px;
                            max-height: 70px;
                            opacity: root.has-track ? 1 : 0.45;
                            accessible-role: button;
                            accessible-label: root.playing ? I18n.t("Tạm dừng", "Pause") : I18n.t("Phát", "Play");
                            property <length> play-inset: play-touch.pressed && root.has-track ? 3px : 0px;
                            play-focus := FocusScope {
                                enabled: root.has-track;
                                key-pressed(event) => {
                                    if (root.has-track && (event.text == Key.Return || event.text == Key.Space)) {
                                        root.play-pause();
                                        return EventResult.accept;
                                    }
                                    return EventResult.reject;
                                }
                            }
                            Rectangle {
                                x: parent.play-inset / 2;
                                y: parent.play-inset / 2;
                                width: parent.width - parent.play-inset;
                                height: parent.height - parent.play-inset;
                                border-radius: (parent.width - parent.play-inset) / 2;
                                border-width: play-focus.has-focus ? 2px : 0px;
                                border-color: Theme.text;
                                background: play-touch.has-hover && root.has-track ? Theme.accent.brighter(0.1) : Theme.accent;
                                animate background { duration: Motion.fast; }
                                PlayPauseMorph {
                                    x: (parent.width - 30px) / 2;
                                    y: (parent.height - 30px) / 2;
                                    width: 30px;
                                    height: 30px;
                                    fill: Theme.on-accent;
                                    m: root.playing ? 1 : 0;
                                    animate m { duration: Motion.slow; easing: ease-in-out; }
                                }
                            }
                            play-touch := TouchArea {
                                enabled: root.has-track;
                                mouse-cursor: root.has-track ? MouseCursor.pointer : MouseCursor.default;
                                clicked => { if (root.has-track) { root.play-pause(); } }
                            }
                        }
                        IconButton {
                            icon: Icons.next;
                            label: I18n.t("Bài tiếp theo", "Next");
                            size: 52px;
                            icon-size: 24px;
                            filled-icon: true;
                            plate: true;
                            enabled: root.has-track;
                            tint: Theme.text;
                            clicked => { root.next(); }
                        }
                        IconButton {
                            icon: Icons.skip-forward;
                            badge: "10";
                            label: I18n.t("Tiến 10 giây", "Forward 10 seconds");
                            size: 46px;
                            icon-size: 32px;
                            weight: 2px;
                            plate: true;
                            enabled: root.has-track;
                            tint: Theme.text;
                            clicked => { root.seek-forward(); }
                        }
                        // Icon alone shows the mode: grey = off, accent = all, accent + "1" = one track.
                        IconButton {
                            icon: Icons.repeat;
                            label: root.repeat-mode == 0 ? I18n.t("Lặp: tắt", "Repeat: off") : (root.repeat-mode == 1 ? I18n.t("Lặp: tất cả", "Repeat: all") : I18n.t("Lặp: một bài", "Repeat: one track"));
                            size: 46px;
                            icon-size: 28px;
                            weight: 2.2px;
                            plate: true;
                            tint: Theme.text;
                            badge: "1";
                            badge-shown: root.repeat-mode == 2;
                            active: root.repeat-mode > 0;
                            clicked => { root.cycle-repeat(); }
                        }
                    }

                    HDivider { x: 0; y: parent.height - 70px; width: parent.width; }

                    HorizontalLayout {
                        x: 0;
                        y: parent.height - 60px;
                        width: parent.width;
                        height: 52px;
                        spacing: 14px;
                        IconButton {
                            icon: Icons.stop;
                            label: I18n.t("Dừng", "Stop");
                            size: 42px;
                            icon-size: 18px;
                            filled-icon: true;
                            plate: true;
                            enabled: root.has-track;
                            tint: Theme.text;
                            clicked => { root.stop(); }
                        }
                        VDivider { }
                        Glyph {
                            glyph-size: 24px;
                            weight: 2px;
                            icon: Icons.volume;
                            tint: Theme.text;
                        }
                        VolumeSlider {
                            min-width: 200px;
                            max-width: 260px;
                            volume: root.volume;
                            set-volume(value) => { root.set-volume(value); }
                        }
                        Text {
                            text: root.volume-label;
                            color: Theme.muted;
                            font-size: 13px;
                            min-width: 44px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.now-device;
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    x: parent.width * 0.55 - 12px;
                    y: 6px;
                    width: 1px;
                    height: parent.height - 12px;
                    background: @linear-gradient(180deg, transparent 0%, Theme.line 8%, Theme.line 92%, transparent 100%);
                }

                // Right column
                Rectangle {
                    x: parent.width * 0.55 + 4px;
                    y: 0;
                    width: parent.width * 0.45 - 16px;
                    height: parent.height;
                    background: transparent;

                    Rectangle {
                        x: 16px;
                        y: 0;
                        width: parent.width - 20px;
                        height: 46px;
                        background: transparent;
                        visible: !root.settings-visible && !root.lyrics-visible;
                        HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            spacing: 22px;
                            TabHeader {
                                text: I18n.t("Bài hát", "Songs");
                                selected: root.tab == 0;
                                clicked => { root.tab = 0; }
                            }
                            TabHeader {
                                text: "Playlist";
                                selected: root.tab == 1;
                                clicked => { root.tab = 1; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            IconButton {
                                visible: root.tab == 1;
                                icon: Icons.plus;
                                label: I18n.t("Tạo playlist", "New playlist");
                                icon-size: 16px;
                                clicked => {
                                    root.dialog-mode = 1;
                                    root.dialog-title = I18n.t("Playlist mới", "New playlist");
                                    root.dialog-text = "";
                                }
                            }
                        }
                    }

                    Rectangle {
                        x: 16px;
                        y: 46px;
                        width: parent.width - 20px;
                        height: parent.height - 46px;
                        background: transparent;
                        visible: root.tab == 0 && !root.lyrics-visible && !root.settings-visible;
                        songs-list := ListView {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            for row[i] in (root.lists-ready ? root.tracks : []) : TrackListItem {
                                title: row.title;
                                artist: row.artist;
                                duration: row.duration;
                                cover: row.cover;
                                missing: row.missing;
                                current: root.current-track == i;
                                selected: root.selected-track == i;
                                // A track whose file is gone can only be removed; others can also go to a playlist.
                                action-icon: row.missing ? Icons.trash : Icons.plus;
                                action-label: row.missing ? I18n.t("Xóa khỏi thư viện", "Remove from library") : I18n.t("Thêm vào playlist", "Add to playlist");
                                action => {
                                    if (row.missing) { root.ask-remove-track(i); } else { root.picker-track = i; }
                                }
                                extra-icon: row.missing ? "" : Icons.trash;
                                extra-label: I18n.t("Xóa khỏi thư viện", "Remove from library");
                                extra => { root.ask-remove-track(i); }
                                activate => {
                                    root.selected-track = i;
                                    root.activate-track(i);
                                }
                            }
                        }
                        ScrollEdgeFade {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            top: true;
                            shown: -songs-list.viewport-y > 2px;
                        }
                        ScrollEdgeFade {
                            x: 0;
                            y: parent.height - self.height;
                            width: parent.width;
                            top: false;
                            shown: songs-list.viewport-height + songs-list.viewport-y > songs-list.height + 2px;
                        }
                        Text {
                            x: 4px;
                            y: 14px;
                            width: parent.width - 8px;
                            text: I18n.t("Chưa có bài hát. Thêm tệp hoặc thư mục ở góc trên.", "No songs yet. Add files or a folder with the + button at the top.");
                            visible: root.tracks.length == 0;
                            wrap: word-wrap;
                            color: Theme.muted;
                            font-size: 14px;
                        }
                    }

                    Rectangle {
                        x: 16px;
                        y: 46px;
                        width: parent.width - 20px;
                        height: parent.height - 46px;
                        background: transparent;
                        visible: root.tab == 1 && !root.lyrics-visible && !root.settings-visible;

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * 0.36;
                            height: parent.height;
                            background: transparent;
                            playlists-list := ListView {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                for play[pi] in (root.lists-ready ? root.playlists : []) : PlaylistListItem {
                                    name: play.name;
                                    count: play.count;
                                    cover: play.cover;
                                    current: root.current-playlist == pi;
                                    activate => { root.select-playlist(pi); }
                                }
                            }
                            ScrollEdgeFade {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                top: true;
                                shown: -playlists-list.viewport-y > 2px;
                            }
                            ScrollEdgeFade {
                                x: 0;
                                y: parent.height - self.height;
                                width: parent.width;
                                top: false;
                                shown: playlists-list.viewport-height + playlists-list.viewport-y > playlists-list.height + 2px;
                            }
                        }
                        Rectangle {
                            x: parent.width * 0.36 + 4px;
                            y: 6px;
                            width: 1px;
                            height: parent.height - 12px;
                            background: @linear-gradient(180deg, transparent 0%, Theme.line 6%, Theme.line 94%, transparent 100%);
                        }
                        Rectangle {
                            x: parent.width * 0.36 + 12px;
                            y: 0;
                            width: parent.width * 0.64 - 12px;
                            height: parent.height;
                            background: transparent;
                            visible: root.current-playlist >= 0;

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: 58px;
                                background: transparent;
                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 0;
                                        Text {
                                            text: root.current-playlist-name;
                                            color: Theme.text;
                                            font-size: 17px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.current-playlist-count;
                                            color: Theme.muted;
                                            font-size: 12px;
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    IconButton {
                                        icon: Icons.play;
                                        filled-icon: true;
                                        label: I18n.t("Phát playlist", "Play playlist");
                                        icon-size: 14px;
                                        clicked => { root.play-playlist(); }
                                    }
                                    IconButton {
                                        icon: Icons.pencil;
                                        label: I18n.t("Đổi tên playlist", "Rename playlist");
                                        icon-size: 14px;
                                        clicked => {
                                            root.dialog-mode = 2;
                                            root.dialog-title = I18n.t("Đổi tên playlist", "Rename playlist");
                                            root.dialog-text = root.current-playlist-name;
                                        }
                                    }
                                    IconButton {
                                        icon: Icons.trash;
                                        label: I18n.t("Xóa playlist", "Delete playlist");
                                        icon-size: 15px;
                                        clicked => {
                                            root.dialog-mode = 3;
                                            root.dialog-title = I18n.t("Xóa playlist này?", "Delete this playlist?");
                                            root.dialog-text = "";
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                x: 0;
                                y: 58px;
                                width: parent.width;
                                height: 1px;
                                background: Theme.line;
                            }
                            Rectangle {
                                x: 0;
                                y: 59px;
                                width: parent.width;
                                height: parent.height - 59px;
                                background: transparent;
                                playlist-songs-list := ListView {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    for row[ti] in (root.lists-ready ? root.playlist-tracks : []) : TrackListItem {
                                        title: row.title;
                                        artist: row.artist;
                                        duration: row.duration;
                                        cover: row.cover;
                                        missing: row.missing;
                                        current: root.current-playlist-track == ti;
                                        selected: false;
                                        action-icon: Icons.trash;
                                        action-label: I18n.t("Bỏ khỏi playlist", "Remove from playlist");
                                        action => { root.remove-playlist-track(ti); }
                                        activate => { root.activate-track(ti); }
                                    }
                                }
                                ScrollEdgeFade {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    top: true;
                                    shown: -playlist-songs-list.viewport-y > 2px;
                                }
                                ScrollEdgeFade {
                                    x: 0;
                                    y: parent.height - self.height;
                                    width: parent.width;
                                    top: false;
                                    shown: playlist-songs-list.viewport-height + playlist-songs-list.viewport-y > playlist-songs-list.height + 2px;
                                }
                                Text {
                                    x: 4px;
                                    y: 10px;
                                    width: parent.width - 8px;
                                    text: I18n.t("Playlist trống.", "This playlist is empty.");
                                    visible: root.playlist-tracks.length == 0;
                                    color: Theme.muted;
                                    font-size: 13px;
                                }
                            }
                        }
                        Text {
                            visible: root.current-playlist < 0;
                            x: parent.width * 0.36 + 12px;
                            y: 20px;
                            width: parent.width * 0.64 - 12px;
                            text: I18n.t("Chọn một playlist bên trái.", "Pick a playlist on the left.");
                            color: Theme.muted;
                            font-size: 13px;
                        }
                    }

                    // Lyrics pane
                    Rectangle {
                        x: 16px;
                        y: 0;
                        width: parent.width - 20px;
                        height: parent.height;
                        background: transparent;
                        visible: root.lyrics-visible && !root.settings-visible;

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: 44px;
                            background: transparent;
                            HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 6px;
                                Text {
                                    text: I18n.t("Lời bài hát", "Lyrics");
                                    color: Theme.text;
                                    font-size: 15px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: root.lyric-offset;
                                    color: Theme.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                IconButton {
                                    icon: Icons.minimize;
                                    label: I18n.t("Dời lời muộn hơn 0,5 giây", "Shift lyrics 0.5 s later");
                                    icon-size: 12px;
                                    size: 24px;
                                    clicked => { root.lyric-offset-step(-1); }
                                }
                                IconButton {
                                    icon: Icons.plus;
                                    label: I18n.t("Dời lời sớm hơn 0,5 giây", "Shift lyrics 0.5 s earlier");
                                    icon-size: 12px;
                                    size: 24px;
                                    clicked => { root.lyric-offset-step(1); }
                                }
                                Rectangle {
                                    min-width: 96px;
                                    max-width: 96px;
                                    accessible-role: button;
                                    accessible-label: I18n.t("Theo bài hát", "Follow song");
                                    Rectangle {
                                        y: (parent.height - 26px) / 2;
                                        height: 26px;
                                        border-radius: 13px;
                                        background: follow-touch.has-hover ? Theme.hover : (root.following ? Theme.accent-soft : transparent);
                                        border-width: 1px;
                                        border-color: root.following ? Theme.accent : Theme.line;
                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: I18n.t("Theo bài hát", "Follow song");
                                            color: root.following ? Theme.accent : Theme.muted;
                                            font-size: 12px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        follow-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.following = true; }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: 0;
                            y: 44px;
                            width: parent.width;
                            height: parent.height - 44px;
                            background: transparent;
                            lyric-scroll := ScrollView {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                VerticalLayout {
                                    spacing: 0;
                                    padding-top: 8px;
                                    padding-bottom: 24px;
                                    for line[li] in root.lyrics : Rectangle {
                                        min-height: line.text == "" ? 14px : 34px;
                                        max-height: line.text == "" ? 14px : 34px;
                                        background: lyric-touch.has-hover && line.timed ? Theme.hover : transparent;
                                        border-radius: 6px;
                                        Text {
                                            x: 6px;
                                            width: parent.width - 12px;
                                            height: parent.height;
                                            text: line.text;
                                            color: line.active ? Theme.accent : Theme.muted;
                                            font-size: line.active ? 16px : 14px;
                                            font-weight: line.active ? 600 : 400;
                                            vertical-alignment: center;
                                            wrap: word-wrap;
                                            overflow: elide;
                                            animate color { duration: Motion.fast; }
                                        }
                                        lyric-touch := TouchArea {
                                            mouse-cursor: line.timed ? MouseCursor.pointer : MouseCursor.default;
                                            clicked => { if (line.timed) { root.following = true; root.lyric-click(line.seconds); } }
                                            scroll-event(event) => { root.following = false; return EventResult.reject; }
                                        }
                                    }
                                }
                            }
                            ScrollEdgeFade {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                top: true;
                                shown: -lyric-scroll.viewport-y > 2px;
                            }
                            ScrollEdgeFade {
                                x: 0;
                                y: parent.height - self.height;
                                width: parent.width;
                                top: false;
                                shown: lyric-scroll.viewport-height + lyric-scroll.viewport-y > lyric-scroll.height + 2px;
                            }
                            Text {
                                x: 6px;
                                y: 12px;
                                width: parent.width - 12px;
                                text: root.lyrics-status;
                                visible: root.lyrics-status != "";
                                wrap: word-wrap;
                                color: Theme.muted;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Settings
                    Rectangle {
                        x: 16px;
                        y: 0;
                        width: parent.width - 20px;
                        height: parent.height;
                        background: transparent;
                        visible: root.settings-visible;
                        // `start` keeps rows at their natural height instead of sharing out the spare space.
                        VerticalLayout {
                            alignment: start;
                            spacing: 12px;
                            padding-top: 4px;
                            Rectangle {
                                min-height: 40px;
                                max-height: 40px;
                                background: transparent;
                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    Text {
                                        text: I18n.t("Cài đặt", "Settings");
                                        color: Theme.text;
                                        font-size: 17px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    IconButton {
                                        icon: Icons.close;
                                        label: I18n.t("Đóng cài đặt", "Close settings");
                                        icon-size: 14px;
                                        clicked => { root.toggle-settings(); }
                                    }
                                }
                            }
                            Text { text: I18n.t("Giao diện", "Appearance"); color: Theme.muted; font-size: 12px; }
                            Rectangle {
                                min-height: 34px;
                                max-height: 34px;
                                HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 6px;
                                for mode[m] in [I18n.t("Hệ thống", "System"), I18n.t("Sáng", "Light"), I18n.t("Tối", "Dark")] : Rectangle {
                                    horizontal-stretch: 1;
                                    min-height: 34px;
                                    max-height: 34px;
                                    border-radius: 8px;
                                    background: root.theme-mode == m ? Theme.accent-soft : (seg-touch.has-hover ? Theme.hover : transparent);
                                    border-width: 1px;
                                    border-color: root.theme-mode == m ? Theme.accent : Theme.line;
                                    accessible-role: button;
                                    accessible-label: mode;
                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: mode;
                                        color: root.theme-mode == m ? Theme.accent : Theme.muted;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    seg-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-theme(m); }
                                    }
                                }
                                }
                            }
                            // Language names stay in their own language so either is findable.
                            Text { text: I18n.t("Ngôn ngữ", "Language"); color: Theme.muted; font-size: 12px; }
                            Rectangle {
                                min-height: 34px;
                                max-height: 34px;
                                HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 6px;
                                for lang[li] in ["Tiếng Việt", "English"] : Rectangle {
                                    property <bool> chosen: (li == 1) == I18n.en;
                                    horizontal-stretch: 1;
                                    min-height: 34px;
                                    max-height: 34px;
                                    border-radius: 8px;
                                    background: self.chosen ? Theme.accent-soft : (lang-touch.has-hover ? Theme.hover : transparent);
                                    border-width: 1px;
                                    border-color: self.chosen ? Theme.accent : Theme.line;
                                    accessible-role: button;
                                    accessible-label: lang;
                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: lang;
                                        color: parent.chosen ? Theme.accent : Theme.muted;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    lang-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-language(li == 1); }
                                    }
                                }
                                }
                            }
                            Rectangle {
                                min-height: 1px;
                                max-height: 1px;
                                background: Theme.line;
                            }
                            Rectangle {
                                min-height: 56px;
                                background: transparent;
                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 0;
                                        Text { text: I18n.t("Tải lời từ LRCLIB", "Fetch lyrics from LRCLIB"); color: Theme.text; font-size: 14px; }
                                        Text { text: I18n.t("Chỉ tên bài, nghệ sĩ, album và thời lượng được gửi.", "Only title, artist, album and duration are sent."); color: Theme.muted; font-size: 12px; overflow: elide; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Rectangle {
                                        min-width: 44px;
                                        max-width: 44px;
                                        accessible-role: switch;
                                        accessible-label: I18n.t("Tải lời từ LRCLIB", "Fetch lyrics from LRCLIB");
                                        Rectangle {
                                            y: (parent.height - 24px) / 2;
                                            height: 24px;
                                            border-radius: 12px;
                                            background: root.lyrics-online ? Theme.accent : Theme.line;
                                            animate background { duration: Motion.fast; }
                                            Rectangle {
                                                x: root.lyrics-online ? 22px : 2px;
                                                y: 2px;
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: root.lyrics-online ? Theme.on-accent : Theme.muted;
                                                animate x { duration: Motion.fast; easing: ease-out; }
                                            }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.set-lyrics-online(!root.lyrics-online); }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                min-height: 56px;
                                background: transparent;
                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 0;
                                        Text { text: I18n.t("Dọn bài lỗi", "Clean up broken songs"); color: Theme.text; font-size: 14px; }
                                        Text { text: I18n.t("Xóa khỏi thư viện các bài không còn file trên máy.", "Removes songs whose file is no longer on disk."); color: Theme.muted; font-size: 12px; overflow: elide; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Rectangle {
                                        min-width: clean-label.preferred-width + 24px;
                                        max-width: clean-label.preferred-width + 24px;
                                        accessible-role: button;
                                        accessible-label: clean-label.text;
                                        Rectangle {
                                            y: (parent.height - 30px) / 2;
                                            height: 30px;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: Theme.line;
                                            background: clean-touch.has-hover ? Theme.hover : transparent;
                                            clean-label := Text {
                                                width: parent.width;
                                                height: parent.height;
                                                text: I18n.t("Dọn", "Clean up");
                                                color: Theme.text;
                                                font-size: 13px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            clean-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.remove-missing(); }
                                            }
                                        }
                                    }
                                }
                            }
                            Text {
                                text: I18n.t("Lời đã tải được lưu trong thư viện và dùng được khi offline.", "Downloaded lyrics are saved in the library and work offline.");
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // Toasts sit at the bottom of the right column, clear of the player controls.
                Rectangle {
                    visible: root.importing;
                    x: parent.width * 0.55 + 20px;
                    y: parent.height - 60px;
                    width: 240px;
                    height: 40px;
                    border-radius: 8px;
                    background: Theme.surface;
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: I18n.t("Đang đọc thư viện…", "Reading library…");
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    visible: root.has-status;
                    x: parent.width * 0.55 + 20px;
                    y: parent.height - 60px;
                    width: min(parent.width * 0.45 - 40px, status-text.preferred-width + 58px);
                    height: 40px;
                    border-radius: 8px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.line;
                    status-text := Text {
                        x: 12px;
                        width: parent.width - 48px;
                        height: parent.height;
                        text: root.status-message;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    IconButton {
                        x: parent.width - 38px;
                        y: 7px;
                        // Outside a layout an element fills its parent unless sized explicitly.
                        width: 26px;
                        height: 26px;
                        icon: Icons.close;
                        label: I18n.t("Đóng thông báo", "Dismiss");
                        icon-size: 12px;
                        size: 26px;
                        clicked => { root.dismiss-status(); }
                    }
                }
            }

        // "Add to playlist" picker for one library track
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: #000000aa;
            visible: root.picker-track >= 0 && root.dialog-mode == 0;
            z: 20;
            TouchArea { clicked => { root.picker-track = -1; } }
            Rectangle {
                width: 320px;
                height: picker-layout.preferred-height;
                x: (parent.width - 320px) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 12px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.line;
                TouchArea { }
                picker-layout := VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: 14px;
                    spacing: 4px;
                    Text {
                        text: I18n.t("Thêm vào playlist", "Add to playlist");
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 600;
                        height: 32px;
                        vertical-alignment: center;
                    }
                    if root.playlists.length == 0: Text {
                        text: I18n.t("Chưa có playlist nào.", "No playlists yet.");
                        color: Theme.muted;
                        font-size: 13px;
                        height: 30px;
                        vertical-alignment: center;
                    }
                    for pl[pi] in root.playlists: Rectangle {
                        min-height: 48px;
                        max-height: 48px;
                        border-radius: 8px;
                        background: pick-touch.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: pl.name;
                        Image {
                            x: 8px;
                            y: 6px;
                            width: 36px;
                            height: 36px;
                            source: pl.cover;
                            image-fit: ImageFit.cover;
                        }
                        Text {
                            x: 54px;
                            width: parent.width - 120px;
                            height: parent.height;
                            text: pl.name;
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            x: parent.width - 62px;
                            width: 54px;
                            height: parent.height;
                            text: pl.count;
                            color: Theme.muted;
                            font-size: 12px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        pick-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.add-track-to-playlist(root.picker-track, pi);
                                root.picker-track = -1;
                            }
                        }
                    }
                    Rectangle {
                        min-height: 44px;
                        max-height: 44px;
                        border-radius: 8px;
                        background: new-touch.has-hover ? Theme.accent-soft : transparent;
                        accessible-role: button;
                        accessible-label: I18n.t("Tạo playlist mới", "Create new playlist");
                        Glyph {
                            x: 16px;
                            y: (parent.height - 18px) / 2;
                            width: 18px;
                            height: 18px;
                            glyph-size: 18px;
                            icon: Icons.plus;
                            tint: Theme.accent;
                        }
                        Text {
                            x: 54px;
                            width: parent.width - 60px;
                            height: parent.height;
                            text: I18n.t("Tạo playlist mới…", "New playlist…");
                            color: Theme.accent;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        // Keeps picker-track so the new playlist receives this song on save.
                        new-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.dialog-mode = 1;
                                root.dialog-title = I18n.t("Playlist mới", "New playlist");
                                root.dialog-text = "";
                            }
                        }
                    }
                }
            }
        }

        // Modal dialog: create / rename / delete playlist
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: #000000cc;
            visible: root.dialog-mode > 0;
            z: 20;
            TouchArea { }
            // Card height follows its content; hidden rows use `if` so they take no space.
            Rectangle {
                width: 380px;
                height: dialog-layout.preferred-height;
                x: (parent.width - 380px) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 12px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.line;
                dialog-layout := VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: 18px;
                    spacing: 14px;
                    Text {
                        text: root.dialog-title;
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 600;
                    }
                    if root.dialog-mode == 1 || root.dialog-mode == 2: Rectangle {
                        min-height: 40px;
                        max-height: 40px;
                        border-radius: 8px;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: name-input.has-focus ? Theme.accent : Theme.line;
                        name-input := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            vertical-alignment: center;
                            init => { self.focus(); self.select-all(); }
                            text: root.dialog-text;
                            color: Theme.text;
                            font-size: 14px;
                            single-line: true;
                            edited => { root.dialog-text = self.text; }
                            accepted => { root.dialog-confirm(self.text); }
                        }
                    }
                    if root.dialog-mode == 4: Text {
                        text: I18n.t("Bài sẽ bị xóa khỏi thư viện và các playlist. File nhạc trên máy không bị xóa.", "The song is removed from the library and playlists. The music file on disk is not deleted.");
                        color: Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if root.dialog-mode == 3: Text {
                        text: I18n.t("Playlist sẽ bị xóa khỏi thư viện. Tệp nhạc trên máy không bị ảnh hưởng.", "The playlist will be removed from the library. Music files on disk are not affected.");
                        color: Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Rectangle {
                            min-width: 88px;
                            min-height: 34px;
                            border-radius: 8px;
                            background: cancel-touch.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: I18n.t("Hủy", "Cancel");
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: I18n.t("Hủy", "Cancel");
                                color: Theme.muted;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            cancel-touch := TouchArea { mouse-cursor: pointer; clicked => { root.dialog-cancel(); } }
                        }
                        Rectangle {
                            min-width: 96px;
                            min-height: 34px;
                            border-radius: 8px;
                            background: confirm-touch.pressed ? Theme.accent.darker(0.08) : (confirm-touch.has-hover ? Theme.accent.brighter(0.1) : Theme.accent);
                            animate background { duration: Motion.fast; }
                            accessible-role: button;
                            accessible-label: root.dialog-mode >= 3 ? I18n.t("Xóa", "Delete") : I18n.t("Lưu", "Save");
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: root.dialog-mode >= 3 ? I18n.t("Xóa", "Delete") : I18n.t("Lưu", "Save");
                                color: Theme.on-accent;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            confirm-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.dialog-confirm(root.dialog-text); }
                            }
                        }
                    }
                }
            }
        }
    }
}
